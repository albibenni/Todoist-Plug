{
  "name": "Todoist-Plug",
  "version": "0.0.1",
  "description": "A robust integration between Todoist and Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "release": "node release.mjs",
    "lint": "biome check .",
    "indent:write": "biome format --write ."
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@doist/todoist-sdk": "^13.0.0"
  }
}
