{
  "name": "Todoist-Plug",
  "version": "1.0.7",
  "description": "A robust integration between Todoist and Obsidian",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "release": "node release.mjs",
    "version": "node version-bump.mjs && pnpm run indent:write && git add manifest.json versions.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "indent:write": "biome format --write .",
    "prepare": "husky"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^22.15.17",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.25.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@doist/todoist-sdk": "^13.0.0",
    "zod": "^4.4.3"
  },
  "resolutions": {
    "undici": ">=7.28.0"
  }
}
